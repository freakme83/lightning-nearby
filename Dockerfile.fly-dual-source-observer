FROM node:22-slim
WORKDIR /app

# The observer image contains only its own runtime plus source decoders and the
# pure read-only Ankara geometry helper. It excludes every publication adapter.
COPY scripts/research/dual-source-observer/ ./scripts/research/dual-source-observer/
COPY scripts/research/blitzortung-probe/protocol.ts ./scripts/research/blitzortung-probe/protocol.ts
COPY scripts/live-lightning-listener/core.ts ./scripts/live-lightning-listener/core.ts
COPY scripts/lightning-incident-lifecycle/monitoring-area.ts ./scripts/lightning-incident-lifecycle/monitoring-area.ts

ENV NODE_ENV=production
CMD ["node", "--experimental-strip-types", "scripts/research/dual-source-observer/runner.ts"]
